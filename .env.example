# RadioRang environment variables.
# Copy to .env (or set in your host's project settings) as needed.
# NONE of these are secrets — they are public deployment URLs.

# --- Realtime server (Node) ---
# Port to listen on.
# PORT=3000

# Comma-separated origins allowed to call this server cross-origin.
# Set when the frontend is hosted separately (e.g. on Vercel), so the
# browser's requests from that origin are accepted. Empty = allow any origin
# (fine for a demo; tighten in production).
# RR_ALLOWED_ORIGINS=https://your-app.vercel.app

# Override the Content-Security-Policy header if you need different hosts.
# RR_CSP=default-src 'self'; ...

# --- Frontend (build-time, injected into public/rr-config.js) ---
# Base URL of the realtime server's HTTP API (no trailing slash).
# Leave empty when the Node server also serves the frontend (same origin).
# RR_API_BASE=https://rr-api.example.com

# Base URL of the WebSocket relay (ws:// or wss://). Leave empty for same origin.
# RR_WS_BASE=wss://rr-api.example.com

# Public origin of THIS frontend — used for canonical URLs and share-link
# metadata. Falls back to the browser's current origin when unset.
# PUBLIC_ORIGIN=https://your-app.vercel.app
